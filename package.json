{
  "name": "@veterancrowd/aws-service-config",
  "version": "1.0.23",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/veterancrowd/aws-service-config"
  },
  "author": "Jason G. Williscroft",
  "bugs": {
    "url": "https://github.com/veterancrowd/aws-service-config/issues"
  },
  "description": "Abstracts service connections into a class.",
  "homepage": "https://github.com/veterancrowd/aws-service-config#readme",
  "keywords": [
    "aws"
  ],
  "license": "BSD-3-Clause",
  "dependencies": {
    "@aws-sdk/client-api-gateway": "^3.844.0",
    "ajv": "^8.17.1",
    "exponential-backoff": "^3.1.2",
    "fs-extra": "^11.3.0",
    "http-errors": "^2.0.0",
    "lodash": "^4.17.21",
    "openapi-client-axios": "^7.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/eslint-parser": "^7.28.0",
    "@babel/plugin-syntax-import-assertions": "^7.27.1",
    "@babel/preset-env": "^7.28.0",
    "@babel/register": "^7.27.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.19.6",
    "@veterancrowd/aws-cli": "^6.1.4",
    "auto-changelog": "^2.5.0",
    "chai": "^5.2.1",
    "concat-md": "^0.5.1",
    "crlf": "^1.1.1",
    "eslint": "=8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^48.11.0",
    "eslint-plugin-mocha": "^10.5.0",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-yml": "^1.18.0",
    "jsdoc-to-markdown": "^8.0.3",
    "knip": "^5.61.3",
    "lefthook": "^1.12.1",
    "license-check-and-add": "^4.0.5",
    "mocha": "^10.8.2",
    "release-it": "^17.11.0"
  },
  "exports": {
    ".": {
      "import": "./lib/index.js"
    }
  },
  "main": "./lib/index.js",
  "mocha": {
    "exclude": [
      "./node_modules/**"
    ],
    "file": "./test/setup.js",
    "require": [
      "@babel/register"
    ],
    "spec": "./**/*.test.!(*.*)",
    "timeout": 60000
  },
  "release-it": {
    "git": {
      "changelog": "npx auto-changelog --stdout --commit-limit false -u --template https://raw.githubusercontent.com/release-it/release-it/main/templates/changelog-compact.hbs",
      "requireBranch": "dev",
      "commitMessage": "chore: release v${version}"
    },
    "github": {
      "release": true
    },
    "hooks": {
      "after:init": [
        "nr lint",
        "nr test"
      ],
      "after:release": [
        "git switch -c release/${version}",
        "git push -u origin release/${version}",
        "git switch ${branchName}"
      ]
    },
    "npm": {
      "publish": true
    }
  },
  "scripts": {
    "build": "babel lib -d dist/default/lib --delete-dir-on-start --config-file ./dist/default/.babelrc",
    "knip": "knip",
    "lint": "eslint lib/**",
    "release": "vc -c \"release-it\"",
    "release:pre": "vc -c \"release-it --no-git.requireBranch --github.prerelease --preRelease\"",
    "test": "vc -c \"mocha\""
  },
  "type": "module"
}
